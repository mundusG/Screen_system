{
    "system": {
        "name": "大屏推理显示系统",
        "version": "1.0.0",
        "maxCameras": 8,
        "displayLayout": {
            "rows": 2,
            "cols": 4
        },
        "mode": "mqtt_subscribe"
    },
    "mqtt_sources": [
        {
            "id": "cameras_1_4",
            "enabled": true,
            "broker": "tcp://127.0.0.1:1883",
            "client_id": "display_cameras_1_4",
            "username": "",
            "password": "",
            "discovery_topic": "inference/bridge/+/channels",
            "camera_id_min": 0,
            "camera_id_max": 3
        },
        {
            "id": "cameras_5_8",
            "enabled": false,
            "broker": "tcp://127.0.0.1:1884",
            "client_id": "display_cameras_5_8",
            "username": "",
            "password": "",
            "discovery_topic": "inference/bridge/+/channels",
            "camera_id_min": 4,
            "camera_id_max": 7
        }
    ],
    "services": {
        "check_mosquitto": true
    },
    "cameras": [
        {
            "cameraId": 0,
            "name": "摄像头 1",
            "source": "rtsp://127.0.0.1:554/Streaming/Channels/101",
            "enabled": true,
            "mode": "mqtt_subscribe",
            "mqtt_topic": "inference/camera/0/detections",
            "confidenceThreshold": 0.5,
            "smoothingAlpha": 0.3,
            "trackMaxLost": 5,
            "inferenceIntervalMs": 1000,
            "classColors": {
                "0": "#00FF00",
                "1": "#FF0000"
            }
        },
        {
            "cameraId": 1,
            "name": "摄像头 2",
            "source": "1",
            "enabled": true,
            "mode": "mqtt_subscribe",
            "mqtt_topic": "inference/camera/1/detections",
            "confidenceThreshold": 0.5,
            "smoothingAlpha": 0.3,
            "trackMaxLost": 5,
            "inferenceIntervalMs": 1000,
            "classColors": {
                "0": "#00FF00",
                "1": "#FF0000"
            }
        },
        {
