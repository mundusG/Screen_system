{
    "system": {
        "name": "大屏推理显示系统",
        "version": "1.0.0",
        "maxCameras": 8,
        "displayLayout": {
            "rows": 2,
            "cols": 4
        },
        "mode": "mqtt_subscribe"
    },
    "mqtt": {
        "broker": "tcp://192.168.77.145:1883",
        "client_id": "display_device",
        "username": "",
        "password": "",
        "discovery_topic": "inference/bridge/+/channels"
    },
    "services": {
        "nn_bridge": {
            "enabled": true,
            "script": "rk3576/nn_bridge.py",
            "config": "rk3576/bridge_config.json",
            "python": "python3"
        },
        "check_mosquitto": true
    },
    "cameras": [
        {
            "cameraId": 0,
            "name": "摄像头 1",
            "source": "rtsp://admin:qs%40123456@169.254.98.43:554/Streaming/Channels/101",
            "modelPath": "best.onnx",
            "enabled": true,
            "mode": "mqtt_subscribe",
            "mqtt_topic": "inference/camera/0/detections",
            "confidenceThreshold": 0.5,
            "nmsThreshold": 0.45,
            "inputWidth": 640,
            "inputHeight": 640,
            "smoothingAlpha": 0.3,
            "trackMaxLost": 5,
            "inferenceIntervalMs": 1000,
            "classColors": {
                "0": "#00FF00",
                "1": "#FF0000"
