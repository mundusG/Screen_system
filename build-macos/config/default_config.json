{
    "system": {
        "name": "大屏推理显示系统",
        "version": "1.0.0",
        "maxCameras": 8,
        "displayLayout": { "rows": 2, "cols": 4 },
        "mode": "mqtt_subscribe"
    },
    "mqtt_sources": [
        {
            "id": "cameras_1_4",
            "enabled": true,
            "broker": "tcp://192.168.1.110:1883",
            "client_id": "display_cameras_1_4",
            "username": "",
            "password": "",
            "discovery_topic": "inference/bridge/+/channels",
            "camera_id_min": 0,
            "camera_id_max": 3
        },
        {
            "id": "cameras_5_8",
            "enabled": false,
            "broker": "",
            "client_id": "display_cameras_5_8",
            "username": "",
            "password": "",
            "discovery_topic": "inference/bridge/+/channels",
            "camera_id_min": 4,
            "camera_id_max": 7
        }
    ],
    "services": {
        "nn_bridge": { "enabled": false },
        "check_mosquitto": false
    },
    "cameras": []
}
